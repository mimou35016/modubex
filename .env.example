# Copy to .env.local for local development. Never commit real secrets.
DATABASE_URL="postgresql://postgres:root@localhost:5433/modubex?schema=public"

# Public app URL, used by auth callbacks and emails in later milestones.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Infrastructure settings are read-only in the UI by design.
BETTER_AUTH_URL="http://localhost:3000"
# Local-only example. Generate a real secret for any deployed environment.
BETTER_AUTH_SECRET="dev-only-secret-change-me-before-production"

# Password policy (validated at startup; Better Auth enforces min/max).
AUTH_PASSWORD_MIN_LENGTH="12"
AUTH_PASSWORD_MAX_LENGTH="128"
AUTH_PASSWORD_REQUIRE_NUMBER="true"
AUTH_PASSWORD_REQUIRE_SYMBOL="false"

# Identity policies.
AUTH_REQUIRE_EMAIL_VERIFICATION="false"
AUTH_2FA_REQUIRED="false"

# Mail adapter (infrastructure-only, read-only in the UI).
# "smtp" is the default and works with Mailpit on localhost:1025.
# "log" writes messages to the application log instead of sending them.
MAIL_DRIVER="smtp"
SMTP_HOST="localhost"
SMTP_PORT="1025"
# Mailpit does not use TLS; enable SMTP_SECURE for a real SMTPS server.
SMTP_SECURE="false"
# Leave these commented for an unauthenticated local SMTP server.
# SMTP_USER=""
# SMTP_PASSWORD=""
SMTP_FROM="Modubex <no-reply@modubex.local>"

# File storage adapter (infrastructure-only, read-only in the UI).
# "local" writes uploads to this server-side path, relative to the project root.
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH=".data/uploads"

# S3-compatible option: set STORAGE_DRIVER="s3" and supply the values below.
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION="us-east-1"
# Leave the endpoint blank for AWS S3; set it for MinIO, LocalStack, etc.
# STORAGE_S3_ENDPOINT=""
# STORAGE_S3_ACCESS_KEY_ID=""
# STORAGE_S3_SECRET_ACCESS_KEY=""
# Most S3-compatible services require path-style addressing; AWS S3 does not.
STORAGE_S3_FORCE_PATH_STYLE="false"

# OAuth providers are enabled only when BOTH values for that provider are set.
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Idempotent first-Owner seed (local development defaults shown).
SEED_OWNER_EMAIL="owner@modubex.local"
SEED_OWNER_PASSWORD="Owner!Local2026#"

# Audit log retention in days. 0 (the default) keeps entries forever.
# A retention purge writes its own audit entry. Maximum 3650 days.
AUDIT_RETENTION_DAYS="0"
