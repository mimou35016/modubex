# Dependencies and build output are installed/generated inside the image.
node_modules
.next
out
build

# Local git metadata and secrets must never enter the build context.
.git
.gitignore
.env*

# Uploads come from a mounted named volume, never from the image.
.data

# Logs, caches, and editor/temp files.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
coverage
.tmp
tmp
temp
*.tmp
*.swp
.DS_Store
.vscode
.idea
